PROCEDURE DIVISION.
MAIN.
    DISPLAY "DATA STRUCTURES ADVANCED - Unit tests"
    PERFORM TEST-TREE-NODE
    PERFORM TEST-BINARY-TREE
    PERFORM TEST-GRAPH
    DISPLAY "CASES: " WS-CASE-TOTAL
        " PASSED: " WS-CASE-PASSED " FAILED: " WS-CASE-FAILED
    PERFORM ASSERT-REPORT
    STOP RUN.

TEST-TREE-NODE.
    MOVE "tree node create" TO WS-CASE-NAME
    MOVE WS-CREATE-NODE-INPUT TO WS-CASE-INPUT
    MOVE WS-CREATE-NODE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "tree node absent initial links" TO WS-CASE-NAME
    MOVE WS-ABSENT-LINKS-INPUT TO WS-CASE-INPUT
    MOVE WS-ABSENT-LINKS-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "tree node link two children" TO WS-CASE-NAME
    MOVE WS-LINK-CHILDREN-INPUT TO WS-CASE-INPUT
    MOVE WS-LINK-CHILDREN-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "tree node traverse each link" TO WS-CASE-NAME
    MOVE WS-TRAVERSE-LINKS-INPUT TO WS-CASE-INPUT
    MOVE WS-TRAVERSE-LINKS-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "tree node unlink children" TO WS-CASE-NAME
    MOVE WS-UNLINK-CHILDREN-INPUT TO WS-CASE-INPUT
    MOVE WS-UNLINK-CHILDREN-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE.

TEST-BINARY-TREE.
    MOVE "binary tree create empty" TO WS-CASE-NAME
    MOVE WS-EMPTY-TREE-INPUT TO WS-CASE-INPUT
    MOVE WS-EMPTY-TREE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree insert root" TO WS-CASE-NAME
    MOVE WS-ROOT-INPUT TO WS-CASE-INPUT
    MOVE WS-ROOT-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree insert lower and higher" TO WS-CASE-NAME
    MOVE WS-LOWER-HIGHER-INPUT TO WS-CASE-INPUT
    MOVE WS-LOWER-HIGHER-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree multilevel branches" TO WS-CASE-NAME
    MOVE WS-MULTILEVEL-INPUT TO WS-CASE-INPUT
    MOVE WS-MULTILEVEL-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree missing value in nonempty tree" TO WS-CASE-NAME
    MOVE WS-MISSING-VALUE-INPUT TO WS-CASE-INPUT
    MOVE WS-MISSING-VALUE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree idempotent duplicate" TO WS-CASE-NAME
    MOVE WS-DUPLICATE-VALUE-INPUT TO WS-CASE-INPUT
    MOVE WS-DUPLICATE-VALUE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "binary tree ordered insertions" TO WS-CASE-NAME
    MOVE WS-ORDERED-INPUT TO WS-CASE-INPUT
    MOVE WS-ORDERED-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE.

TEST-GRAPH.
    MOVE "graph create empty" TO WS-CASE-NAME
    MOVE WS-EMPTY-GRAPH-INPUT TO WS-CASE-INPUT
    MOVE WS-EMPTY-GRAPH-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph isolated vertex" TO WS-CASE-NAME
    MOVE WS-ISOLATED-INPUT TO WS-CASE-INPUT
    MOVE WS-ISOLATED-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph nonconsecutive labels and directed edge" TO WS-CASE-NAME
    MOVE WS-DIRECTED-INPUT TO WS-CASE-INPUT
    MOVE WS-DIRECTED-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph duplicate vertex preserves adjacency" TO WS-CASE-NAME
    MOVE WS-DUPLICATE-VERTEX-INPUT TO WS-CASE-INPUT
    MOVE WS-DUPLICATE-VERTEX-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph duplicate edge" TO WS-CASE-NAME
    MOVE WS-DUPLICATE-EDGE-INPUT TO WS-CASE-INPUT
    MOVE WS-DUPLICATE-EDGE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph missing endpoint without mutation" TO WS-CASE-NAME
    MOVE WS-MISSING-ENDPOINT-INPUT TO WS-CASE-INPUT
    MOVE WS-MISSING-ENDPOINT-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph sorted neighbours and counts" TO WS-CASE-NAME
    MOVE WS-SORTED-NEIGHBORS-INPUT TO WS-CASE-INPUT
    MOVE WS-SORTED-NEIGHBORS-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph missing edge query" TO WS-CASE-NAME
    MOVE WS-MISSING-EDGE-INPUT TO WS-CASE-INPUT
    MOVE WS-MISSING-EDGE-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph neighbours of missing vertex" TO WS-CASE-NAME
    MOVE WS-MISSING-VERTEX-INPUT TO WS-CASE-INPUT
    MOVE WS-MISSING-VERTEX-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph self loop and duplicate" TO WS-CASE-NAME
    MOVE WS-SELF-LOOP-INPUT TO WS-CASE-INPUT
    MOVE WS-SELF-LOOP-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE
    MOVE "graph neighbour result isolation" TO WS-CASE-NAME
    MOVE WS-NEIGHBOR-ISOLATION-INPUT TO WS-CASE-INPUT
    MOVE WS-NEIGHBOR-ISOLATION-OUTPUT TO WS-CASE-OUTPUT
    PERFORM RUN-CASE.

RUN-CASE.
    ADD 1 TO WS-CASE-TOTAL
    MOVE WS-ASSERT-FAILED TO WS-CASE-START
    INITIALIZE WS-NODES
    SET WS-SAVED-NEIGHBORS TO NULL
    MOVE 0 TO WS-SAVED-COUNT
    MOVE 1 TO WS-INPUT-POSITION WS-OUTPUT-POSITION
    PERFORM UNTIL WS-INPUT-POSITION >
        FUNCTION LENGTH(FUNCTION TRIM(WS-CASE-INPUT))
        MOVE SPACES TO WS-STEP WS-EXPECTED-STEP WS-OPERATION
            WS-FIRST-TEXT WS-SECOND-TEXT
        UNSTRING WS-CASE-INPUT DELIMITED BY "|"
            INTO WS-STEP WITH POINTER WS-INPUT-POSITION
        END-UNSTRING
        UNSTRING WS-CASE-OUTPUT DELIMITED BY "|"
            INTO WS-EXPECTED-STEP WITH POINTER WS-OUTPUT-POSITION
        END-UNSTRING
        UNSTRING FUNCTION TRIM(WS-STEP) DELIMITED BY ALL SPACE
            INTO WS-OPERATION WS-FIRST-TEXT WS-SECOND-TEXT
        END-UNSTRING
        MOVE FUNCTION NUMVAL(WS-FIRST-TEXT) TO WS-FIRST-INPUT
        MOVE FUNCTION NUMVAL(WS-SECOND-TEXT) TO WS-SECOND-INPUT
        *> Los pasos de vecinos esperan "count,label,...": NUMVAL leeria la
        *> coma como separador de miles (1,30 daria 130), asi que aqui solo
        *> se convierte el esperado escalar y la lista la juzga
        *> ASSERT-NEIGHBORS.
        MOVE 0 TO WS-COMMA-COUNT
        INSPECT WS-EXPECTED-STEP TALLYING WS-COMMA-COUNT FOR ALL ","
        IF WS-COMMA-COUNT = 0
            MOVE FUNCTION NUMVAL(WS-EXPECTED-STEP) TO WS-ASSERT-EXPECTED
        END-IF
        MOVE -999999999 TO WS-RESULT
        MOVE 1 TO WS-DO-ASSERT
        MOVE 0 TO WS-CHECK-POINTER
        MOVE SPACES TO WS-ASSERT-NAME
        STRING FUNCTION TRIM(WS-CASE-NAME) " "
            FUNCTION TRIM(WS-STEP) " should return "
            FUNCTION TRIM(WS-EXPECTED-STEP)
            INTO WS-ASSERT-NAME
        END-STRING
        PERFORM RUN-OPERATION
        IF WS-DO-ASSERT = 1
            MOVE WS-RESULT TO WS-ASSERT-ACTUAL
            PERFORM ASSERT-EQUAL
        END-IF
    END-PERFORM
    PERFORM RELEASE-CASE
    IF WS-ASSERT-FAILED = WS-CASE-START
        ADD 1 TO WS-CASE-PASSED
        DISPLAY "[CASE OK] " FUNCTION TRIM(WS-CASE-NAME)
    ELSE
        ADD 1 TO WS-CASE-FAILED
        DISPLAY "[CASE FAIL] " FUNCTION TRIM(WS-CASE-NAME)
    END-IF.

RUN-OPERATION.
    EVALUATE WS-OPERATION
        WHEN "TREE-NODE-INIT" PERFORM TEST-TREE-NODE-INIT
        WHEN "TREE-NODE-GET-VALUE" PERFORM TEST-TREE-NODE-GET-VALUE
        WHEN "TREE-NODE-GET-LEFT" PERFORM TEST-TREE-NODE-GET-LEFT
        WHEN "TREE-NODE-GET-RIGHT" PERFORM TEST-TREE-NODE-GET-RIGHT
        WHEN "TREE-NODE-SET-LEFT" PERFORM TEST-TREE-NODE-SET-LEFT
        WHEN "TREE-NODE-SET-RIGHT" PERFORM TEST-TREE-NODE-SET-RIGHT
        WHEN "BINARY-TREE-INIT" PERFORM TEST-BINARY-TREE-INIT
        WHEN "BINARY-TREE-INSERT" PERFORM TEST-BINARY-TREE-INSERT
        WHEN "BINARY-TREE-CONTAINS" PERFORM TEST-BINARY-TREE-CONTAINS
        WHEN "BINARY-TREE-IS-EMPTY" PERFORM TEST-BINARY-TREE-IS-EMPTY
        WHEN "BINARY-TREE-SIZE" PERFORM TEST-BINARY-TREE-SIZE
        WHEN "GRAPH-INIT" PERFORM TEST-GRAPH-INIT
        WHEN "GRAPH-ADD-VERTEX" PERFORM TEST-GRAPH-ADD-VERTEX
        WHEN "GRAPH-ADD-EDGE" PERFORM TEST-GRAPH-ADD-EDGE
        WHEN "GRAPH-HAS-EDGE" PERFORM TEST-GRAPH-HAS-EDGE
        WHEN "GRAPH-IS-EMPTY" PERFORM TEST-GRAPH-IS-EMPTY
        WHEN "GRAPH-VERTEX-COUNT" PERFORM TEST-GRAPH-VERTEX-COUNT
        WHEN "GRAPH-EDGE-COUNT" PERFORM TEST-GRAPH-EDGE-COUNT
        WHEN "GRAPH-GET-NEIGHBORS"
        WHEN "SAVE-NEIGHBORS"
        WHEN "MUTATE-NEIGHBORS"
            PERFORM TEST-GRAPH-GET-NEIGHBORS
        WHEN "CHECK-SAVED-NEIGHBORS"
            SET WS-NEIGHBORS TO WS-SAVED-NEIGHBORS
            MOVE WS-SAVED-COUNT TO WS-NEIGHBOR-COUNT
            PERFORM ASSERT-NEIGHBORS
            MOVE 0 TO WS-DO-ASSERT
        WHEN OTHER
            DISPLAY "Unknown test operation: " WS-OPERATION
            MOVE 1 TO WS-ASSERT-EXPECTED
            MOVE 0 TO WS-RESULT
    END-EVALUATE.

*> Un subscript fuera de 1..8 aborta con EC-SUBSCRIPT-RANGE y sin mensaje
*> util: se valida antes de tocar WS-NODE y el fallo queda registrado.
GUARD-SLOT.
    MOVE 0 TO WS-SLOT-OK
    MOVE WS-SLOT TO WS-SLOT-TEXT
    IF WS-SLOT >= 1 AND WS-SLOT <= 8
        MOVE 1 TO WS-SLOT-OK
    ELSE
        ADD 1 TO WS-ASSERT-TOTAL
        ADD 1 TO WS-ASSERT-FAILED
        DISPLAY "  [FAIL] " FUNCTION TRIM(WS-CASE-NAME)
            " node slot out of range: " FUNCTION TRIM(WS-SLOT-TEXT)
        MOVE 0 TO WS-DO-ASSERT
    END-IF.

TEST-TREE-NODE-INIT.
    MOVE WS-FIRST-INPUT TO WS-SLOT
    PERFORM GUARD-SLOT
    IF WS-SLOT-OK = 1
        CALL "TREE-NODE-INIT" USING WS-NODE(WS-FIRST-INPUT)
            WS-SECOND-INPUT
        MOVE 0 TO WS-RESULT
        IF WS-NODE(WS-FIRST-INPUT) NOT = NULL
            MOVE 1 TO WS-RESULT
        END-IF
    END-IF.

*> Never dereference a failed constructor: report an assertion instead.
TEST-TREE-NODE-GET-VALUE.
    MOVE WS-FIRST-INPUT TO WS-SLOT
    PERFORM GUARD-SLOT
    IF WS-SLOT-OK = 1
        IF WS-NODE(WS-FIRST-INPUT) NOT = NULL
            CALL "TREE-NODE-GET-VALUE" USING WS-NODE(WS-FIRST-INPUT)
                WS-RESULT
        END-IF
    END-IF.

TEST-TREE-NODE-GET-LEFT.
    MOVE WS-FIRST-INPUT TO WS-SLOT
    PERFORM GUARD-SLOT
    IF WS-SLOT-OK = 1
        MOVE WS-SECOND-INPUT TO WS-SLOT
        PERFORM GUARD-SLOT
    END-IF
    IF WS-SLOT-OK = 1
        IF WS-NODE(WS-FIRST-INPUT) NOT = NULL
            SET WS-LINK-NODE TO NULL
            CALL "TREE-NODE-GET-LEFT" USING WS-NODE(WS-FIRST-INPUT)
                WS-LINK-NODE
            SET WS-NODE(WS-SECOND-INPUT) TO WS-LINK-NODE
            PERFORM ASSERT-LINK
        END-IF
    END-IF.

TEST-TREE-NODE-GET-RIGHT.
    MOVE WS-FIRST-INPUT TO WS-SLOT
    PERFORM GUARD-SLOT
    IF WS-SLOT-OK = 1
        MOVE WS-SECOND-INPUT TO WS-SLOT
        PERFORM GUARD-SLOT
    END-IF
    IF WS-SLOT-OK = 1
        IF WS-NODE(WS-FIRST-INPUT) NOT = NULL
            SET WS-LINK-NODE TO NULL
            CALL "TREE-NODE-GET-RIGHT" USING WS-NODE(WS-FIRST-INPUT)
                WS-LINK-NODE
            SET WS-NODE(WS-SECOND-INPUT) TO WS-LINK-NODE
            PERFORM ASSERT-LINK
        END-IF
    END-IF.

ASSERT-LINK.
    MOVE 0 TO WS-RESULT
    IF WS-NODE(WS-SECOND-INPUT) NOT = NULL
        MOVE 1 TO WS-RESULT
    END-IF.

TEST-TREE-NODE-SET-LEFT.
    PERFORM CHECK-SETTER-INPUT
    IF WS-CHECK-POINTER = 1
        CALL "TREE-NODE-SET-LEFT" USING WS-SUBJECT-NODE WS-LINK-NODE
    END-IF
    MOVE 0 TO WS-DO-ASSERT.

TEST-TREE-NODE-SET-RIGHT.
    PERFORM CHECK-SETTER-INPUT
    IF WS-CHECK-POINTER = 1
        CALL "TREE-NODE-SET-RIGHT" USING WS-SUBJECT-NODE WS-LINK-NODE
    END-IF
    MOVE 0 TO WS-DO-ASSERT.

CHECK-SETTER-INPUT.
    MOVE 0 TO WS-CHECK-POINTER
    MOVE WS-FIRST-INPUT TO WS-SLOT
    PERFORM GUARD-SLOT
    IF WS-SLOT-OK = 1 AND WS-SECOND-INPUT NOT = 0
        MOVE WS-SECOND-INPUT TO WS-SLOT
        PERFORM GUARD-SLOT
    END-IF
    IF WS-SLOT-OK = 1
        SET WS-SUBJECT-NODE TO WS-NODE(WS-FIRST-INPUT)
        SET WS-LINK-NODE TO NULL
        IF WS-NODE(WS-FIRST-INPUT) NOT = NULL
            IF WS-SECOND-INPUT = 0
                MOVE 1 TO WS-CHECK-POINTER
            ELSE
                IF WS-NODE(WS-SECOND-INPUT) NOT = NULL
                    MOVE 1 TO WS-CHECK-POINTER
                    SET WS-LINK-NODE TO WS-NODE(WS-SECOND-INPUT)
                END-IF
            END-IF
        END-IF
    END-IF.

TEST-BINARY-TREE-INIT.
    CALL "BINARY-TREE-INIT" USING DSA-BINARY-TREE
    MOVE 0 TO WS-DO-ASSERT.
TEST-BINARY-TREE-INSERT.
    CALL "BINARY-TREE-INSERT" USING DSA-BINARY-TREE
        WS-FIRST-INPUT WS-RESULT.
TEST-BINARY-TREE-CONTAINS.
    CALL "BINARY-TREE-CONTAINS" USING DSA-BINARY-TREE
        WS-FIRST-INPUT WS-RESULT.
TEST-BINARY-TREE-IS-EMPTY.
    MOVE 9 TO WS-BOOLEAN-ACTUAL
    CALL "BINARY-TREE-IS-EMPTY" USING DSA-BINARY-TREE WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-RESULT.
TEST-BINARY-TREE-SIZE.
    MOVE 999999999 TO WS-COUNT
    CALL "BINARY-TREE-SIZE" USING DSA-BINARY-TREE WS-COUNT
    MOVE WS-COUNT TO WS-RESULT.
TEST-GRAPH-INIT.
    CALL "GRAPH-INIT" USING DSA-GRAPH
    MOVE 0 TO WS-DO-ASSERT.
TEST-GRAPH-ADD-VERTEX.
    CALL "GRAPH-ADD-VERTEX" USING DSA-GRAPH WS-FIRST-INPUT WS-RESULT.
TEST-GRAPH-ADD-EDGE.
    CALL "GRAPH-ADD-EDGE" USING DSA-GRAPH
        WS-FIRST-INPUT WS-SECOND-INPUT WS-RESULT.
TEST-GRAPH-HAS-EDGE.
    CALL "GRAPH-HAS-EDGE" USING DSA-GRAPH
        WS-FIRST-INPUT WS-SECOND-INPUT WS-RESULT.
TEST-GRAPH-IS-EMPTY.
    MOVE 9 TO WS-BOOLEAN-ACTUAL
    CALL "GRAPH-IS-EMPTY" USING DSA-GRAPH WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-RESULT.
TEST-GRAPH-VERTEX-COUNT.
    MOVE 999999999 TO WS-COUNT
    CALL "GRAPH-VERTEX-COUNT" USING DSA-GRAPH WS-COUNT
    MOVE WS-COUNT TO WS-RESULT.
TEST-GRAPH-EDGE-COUNT.
    MOVE 999999999 TO WS-COUNT
    CALL "GRAPH-EDGE-COUNT" USING DSA-GRAPH WS-COUNT
    MOVE WS-COUNT TO WS-RESULT.

TEST-GRAPH-GET-NEIGHBORS.
    SET WS-NEIGHBORS TO NULL
    MOVE -999999999 TO WS-NEIGHBOR-COUNT
    CALL "GRAPH-GET-NEIGHBORS" USING DSA-GRAPH WS-FIRST-INPUT
        WS-NEIGHBORS WS-NEIGHBOR-COUNT
    PERFORM ASSERT-NEIGHBORS
    EVALUATE WS-OPERATION
        WHEN "SAVE-NEIGHBORS"
            SET WS-SAVED-NEIGHBORS TO WS-NEIGHBORS
            MOVE WS-NEIGHBOR-COUNT TO WS-SAVED-COUNT
        WHEN "MUTATE-NEIGHBORS"
            IF WS-NEIGHBORS NOT = NULL
                SET ADDRESS OF DSA-NEIGHBOR-NODE TO WS-NEIGHBORS
                MOVE 99 TO DSA-NEIGHBOR-LABEL
            END-IF
            CALL "FREE-NEIGHBORS" USING WS-NEIGHBORS WS-NEIGHBOR-COUNT
        WHEN OTHER
            CALL "FREE-NEIGHBORS" USING WS-NEIGHBORS WS-NEIGHBOR-COUNT
    END-EVALUATE
    MOVE 0 TO WS-DO-ASSERT.

ASSERT-NEIGHBORS.
    MOVE 1 TO WS-NEIGHBOR-POSITION
    MOVE SPACES TO WS-EXPECTED-TEXT
    UNSTRING WS-EXPECTED-STEP DELIMITED BY ","
        INTO WS-EXPECTED-TEXT WITH POINTER WS-NEIGHBOR-POSITION
    END-UNSTRING
    MOVE FUNCTION NUMVAL(WS-EXPECTED-TEXT) TO WS-EXPECTED-COUNT
    MOVE WS-EXPECTED-COUNT TO WS-ASSERT-EXPECTED
    MOVE WS-NEIGHBOR-COUNT TO WS-ASSERT-ACTUAL
    MOVE SPACES TO WS-ASSERT-NAME
    STRING FUNCTION TRIM(WS-CASE-NAME) " " FUNCTION TRIM(WS-STEP)
        " count should be " FUNCTION TRIM(WS-EXPECTED-TEXT)
        INTO WS-ASSERT-NAME
    END-STRING
    PERFORM ASSERT-EQUAL
    SET WS-CURRENT TO WS-NEIGHBORS
    PERFORM VARYING WS-NEIGHBOR-INDEX FROM 1 BY 1
        UNTIL WS-NEIGHBOR-INDEX > WS-EXPECTED-COUNT
        MOVE SPACES TO WS-EXPECTED-TEXT
        UNSTRING WS-EXPECTED-STEP DELIMITED BY ","
            INTO WS-EXPECTED-TEXT WITH POINTER WS-NEIGHBOR-POSITION
        END-UNSTRING
        MOVE FUNCTION NUMVAL(WS-EXPECTED-TEXT) TO WS-ASSERT-EXPECTED
        MOVE -999999999 TO WS-ASSERT-ACTUAL
        IF WS-CURRENT NOT = NULL
            SET ADDRESS OF DSA-NEIGHBOR-NODE TO WS-CURRENT
            MOVE DSA-NEIGHBOR-LABEL TO WS-ASSERT-ACTUAL
            SET WS-CURRENT TO DSA-NEIGHBOR-NEXT
        END-IF
        MOVE WS-NEIGHBOR-INDEX TO WS-INDEX-TEXT
        MOVE SPACES TO WS-ASSERT-NAME
        STRING FUNCTION TRIM(WS-CASE-NAME) " " FUNCTION TRIM(WS-STEP)
            " label[" FUNCTION TRIM(WS-INDEX-TEXT) "] should be "
            FUNCTION TRIM(WS-EXPECTED-TEXT)
            INTO WS-ASSERT-NAME
        END-STRING
        PERFORM ASSERT-EQUAL
    END-PERFORM
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE 0 TO WS-ASSERT-ACTUAL
    IF WS-CURRENT = NULL MOVE 1 TO WS-ASSERT-ACTUAL END-IF
    MOVE SPACES TO WS-ASSERT-NAME
    STRING FUNCTION TRIM(WS-CASE-NAME) " " FUNCTION TRIM(WS-STEP)
        " must end after the expected labels"
        INTO WS-ASSERT-NAME
    END-STRING
    PERFORM ASSERT-EQUAL.

RELEASE-CASE.
    EVALUATE TRUE
        WHEN WS-CASE-NAME(1:9) = "tree node"
            *> Detach before freeing: child pointers also live in slots 2/3.
            IF WS-NODE(1) NOT = NULL
                CALL "TREE-NODE-SET-LEFT" USING WS-NODE(1) WS-NULL-NODE
                CALL "TREE-NODE-SET-RIGHT" USING WS-NODE(1) WS-NULL-NODE
            END-IF
            CALL "TREE-NODE-FREE" USING WS-NODE(1)
            CALL "TREE-NODE-FREE" USING WS-NODE(2)
            CALL "TREE-NODE-FREE" USING WS-NODE(3)
        WHEN WS-CASE-NAME(1:11) = "binary tree"
            CALL "BINARY-TREE-FREE" USING DSA-BINARY-TREE
        WHEN OTHER
            CALL "FREE-NEIGHBORS" USING WS-SAVED-NEIGHBORS WS-SAVED-COUNT
            CALL "GRAPH-FREE" USING DSA-GRAPH
    END-EVALUATE.

ASSERT-EQUAL.
    ADD 1 TO WS-ASSERT-TOTAL
    IF WS-ASSERT-ACTUAL = WS-ASSERT-EXPECTED
        ADD 1 TO WS-ASSERT-PASSED
    ELSE
        IF WS-ASSERT-FAILED = WS-CASE-START
            DISPLAY "  [FAIL] " FUNCTION TRIM(WS-ASSERT-NAME)
            DISPLAY "         Expected: " WS-ASSERT-EXPECTED
                " Actual: " WS-ASSERT-ACTUAL
        END-IF
        ADD 1 TO WS-ASSERT-FAILED
    END-IF.

ASSERT-REPORT.
    DISPLAY "SUMMARY:"
    DISPLAY "  Total:    " WS-ASSERT-TOTAL
    DISPLAY "  Passed:   " WS-ASSERT-PASSED
    DISPLAY "  Failed:   " WS-ASSERT-FAILED
    IF WS-ASSERT-FAILED > 0
        DISPLAY "  >>> SOME TESTS FAILED <<<"
        MOVE 1 TO RETURN-CODE
    ELSE
        DISPLAY "  >>> ALL TESTS PASSED <<<"
        MOVE 0 TO RETURN-CODE
    END-IF.
END PROGRAM RUN-TESTS.
