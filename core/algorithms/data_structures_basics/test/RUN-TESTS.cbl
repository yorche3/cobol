IDENTIFICATION DIVISION.
PROGRAM-ID. RUN-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "DATA-STRUCTURES-PARAMS".
01 WS-ASSERT-TOTAL       PIC 9(03) VALUE 0.
01 WS-ASSERT-PASSED      PIC 9(03) VALUE 0.
01 WS-ASSERT-FAILED      PIC 9(03) VALUE 0.
01 WS-ASSERT-EXPECTED    PIC S9(9).
01 WS-ASSERT-ACTUAL      PIC S9(9).
01 WS-BOOLEAN-ACTUAL     PIC 9.
01 WS-ASSERT-NAME        PIC X(80).
01 WS-NODE-A             USAGE POINTER.
01 WS-NODE-B             USAGE POINTER.
01 WS-NODE-NEXT          USAGE POINTER.
01 WS-FIRST-INPUT        PIC S9(9) VALUE 10.
01 WS-SECOND-INPUT       PIC S9(9) VALUE 20.
01 WS-THIRD-INPUT        PIC S9(9) VALUE 30.
01 WS-REUSE-INPUT        PIC S9(9) VALUE 40.
01 WS-HEAD-INPUT         PIC S9(9) VALUE 5.
01 WS-ABSENT-INPUT       PIC S9(9) VALUE 99.

PROCEDURE DIVISION.
MAIN.
    DISPLAY "========================================="
    DISPLAY " DATA STRUCTURES BASICS - Unit tests"
    DISPLAY "========================================="
    PERFORM TEST-NODE
    PERFORM TEST-LINKED-LIST
    PERFORM TEST-STACK
    PERFORM TEST-QUEUE
    PERFORM ASSERT-REPORT
    STOP RUN.

TEST-NODE.
    DISPLAY "--- Node tests ---"
    CALL "NODE-INIT" USING WS-NODE-A WS-FIRST-INPUT
    MOVE 10 TO WS-ASSERT-EXPECTED
    MOVE "node initialize and observe value should return 10"
        TO WS-ASSERT-NAME
    CALL "NODE-GET-VALUE" USING WS-NODE-A WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    CALL "NODE-GET-NEXT" USING WS-NODE-A WS-NODE-NEXT
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "node initialize and observe link should be absent"
        TO WS-ASSERT-NAME
    PERFORM ASSERT-NULL
    CALL "NODE-INIT" USING WS-NODE-B WS-SECOND-INPUT
    CALL "NODE-SET-NEXT" USING WS-NODE-A WS-NODE-B
    MOVE 20 TO WS-ASSERT-EXPECTED
    MOVE "node link and traverse should return 20" TO WS-ASSERT-NAME
    CALL "NODE-GET-NEXT" USING WS-NODE-A WS-NODE-NEXT
    CALL "NODE-GET-VALUE" USING WS-NODE-NEXT WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    CALL "NODE-GET-NEXT" USING WS-NODE-B WS-NODE-NEXT
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "linked node next should be absent" TO WS-ASSERT-NAME
    PERFORM ASSERT-NULL.

TEST-LINKED-LIST.
    DISPLAY "--- LinkedList tests ---"
    CALL "LINKED-LIST-INIT" USING DS-LINKED-LIST
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty state should report empty" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-IS-EMPTY" USING DS-LINKED-LIST WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty state should have size 0" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-SIZE" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "linked list empty state head should fail" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-GET-HEAD" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    CALL "LINKED-LIST-INSERT-TAIL" USING DS-LINKED-LIST WS-FIRST-INPUT
    CALL "LINKED-LIST-INSERT-TAIL" USING DS-LINKED-LIST WS-SECOND-INPUT
    CALL "LINKED-LIST-INSERT-HEAD" USING DS-LINKED-LIST WS-HEAD-INPUT
    CALL "LINKED-LIST-INSERT-TAIL" USING DS-LINKED-LIST WS-FIRST-INPUT
    MOVE 4 TO WS-ASSERT-EXPECTED
    MOVE "linked list insert both ends should have size 4" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-SIZE" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 5 TO WS-ASSERT-EXPECTED
    MOVE "linked list insert both ends should have head 5" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-GET-HEAD" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list delete first occurrence should succeed"
        TO WS-ASSERT-NAME
    CALL "LINKED-LIST-DELETE" USING DS-LINKED-LIST WS-FIRST-INPUT
        WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    PERFORM ASSERT-LIST-STATE

    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "linked list delete absent value should fail" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-DELETE" USING DS-LINKED-LIST WS-ABSENT-INPUT
        WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    PERFORM ASSERT-LIST-STATE

    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty should delete head" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-DELETE" USING DS-LINKED-LIST WS-HEAD-INPUT
        WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty should delete middle" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-DELETE" USING DS-LINKED-LIST WS-SECOND-INPUT
        WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty should delete tail" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-DELETE" USING DS-LINKED-LIST WS-FIRST-INPUT
        WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty should report empty" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-IS-EMPTY" USING DS-LINKED-LIST WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "linked list empty should have size 0" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-SIZE" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "linked list empty head should fail" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-GET-HEAD" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

ASSERT-LIST-STATE.
    MOVE 5 TO WS-ASSERT-EXPECTED
    MOVE "linked list state should retain head 5" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-GET-HEAD" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 3 TO WS-ASSERT-EXPECTED
    MOVE "linked list state should retain size 3" TO WS-ASSERT-NAME
    CALL "LINKED-LIST-SIZE" USING DS-LINKED-LIST WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

TEST-STACK.
    DISPLAY "--- Stack tests ---"
    CALL "STACK-INIT" USING DS-STACK
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "stack empty state should report empty" TO WS-ASSERT-NAME
    CALL "STACK-IS-EMPTY" USING DS-STACK WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "stack empty state should have size 0" TO WS-ASSERT-NAME
    CALL "STACK-SIZE" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "stack empty peek should fail" TO WS-ASSERT-NAME
    CALL "STACK-PEEK" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE "stack empty pop should fail" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    CALL "STACK-PUSH" USING DS-STACK WS-FIRST-INPUT
    CALL "STACK-PUSH" USING DS-STACK WS-SECOND-INPUT
    CALL "STACK-PUSH" USING DS-STACK WS-THIRD-INPUT
    MOVE 30 TO WS-ASSERT-EXPECTED
    MOVE "stack LIFO peek should return 30" TO WS-ASSERT-NAME
    CALL "STACK-PEEK" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 3 TO WS-ASSERT-EXPECTED
    MOVE "stack non-mutating peek should retain size 3" TO WS-ASSERT-NAME
    CALL "STACK-SIZE" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    MOVE 30 TO WS-ASSERT-EXPECTED
    MOVE "stack removal should pop 30" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    CALL "STACK-PUSH" USING DS-STACK WS-REUSE-INPUT
    MOVE 40 TO WS-ASSERT-EXPECTED
    MOVE "stack reuse should pop 40" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 20 TO WS-ASSERT-EXPECTED
    MOVE "stack removal should pop 20" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 10 TO WS-ASSERT-EXPECTED
    MOVE "stack removal should pop 10" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    PERFORM ASSERT-STACK-EMPTY
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "stack empty after removal pop should fail" TO WS-ASSERT-NAME
    CALL "STACK-POP" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "stack empty after removal should remain empty" TO WS-ASSERT-NAME
    CALL "STACK-IS-EMPTY" USING DS-STACK WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

ASSERT-STACK-EMPTY.
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "stack removal should finish empty" TO WS-ASSERT-NAME
    CALL "STACK-IS-EMPTY" USING DS-STACK WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "stack removal should finish with size 0" TO WS-ASSERT-NAME
    CALL "STACK-SIZE" USING DS-STACK WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

TEST-QUEUE.
    DISPLAY "--- Queue tests ---"
    CALL "QUEUE-INIT" USING DS-QUEUE
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "queue empty state should report empty" TO WS-ASSERT-NAME
    CALL "QUEUE-IS-EMPTY" USING DS-QUEUE WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "queue empty state should have size 0" TO WS-ASSERT-NAME
    CALL "QUEUE-SIZE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "queue empty peek should fail" TO WS-ASSERT-NAME
    CALL "QUEUE-PEEK" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE "queue empty dequeue should fail" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    CALL "QUEUE-ENQUEUE" USING DS-QUEUE WS-FIRST-INPUT
    CALL "QUEUE-ENQUEUE" USING DS-QUEUE WS-SECOND-INPUT
    CALL "QUEUE-ENQUEUE" USING DS-QUEUE WS-THIRD-INPUT
    MOVE 10 TO WS-ASSERT-EXPECTED
    MOVE "queue FIFO peek should return 10" TO WS-ASSERT-NAME
    CALL "QUEUE-PEEK" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 3 TO WS-ASSERT-EXPECTED
    MOVE "queue non-mutating peek should retain size 3" TO WS-ASSERT-NAME
    CALL "QUEUE-SIZE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL

    MOVE 10 TO WS-ASSERT-EXPECTED
    MOVE "queue removal should dequeue 10" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    CALL "QUEUE-ENQUEUE" USING DS-QUEUE WS-REUSE-INPUT
    MOVE 20 TO WS-ASSERT-EXPECTED
    MOVE "queue reuse should dequeue 20" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 30 TO WS-ASSERT-EXPECTED
    MOVE "queue removal should dequeue 30" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 40 TO WS-ASSERT-EXPECTED
    MOVE "queue removal should dequeue 40" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    PERFORM ASSERT-QUEUE-EMPTY
    MOVE DS-FAILURE-VALUE TO WS-ASSERT-EXPECTED
    MOVE "queue empty after removal dequeue should fail" TO WS-ASSERT-NAME
    CALL "QUEUE-DEQUEUE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "queue empty after removal should remain empty" TO WS-ASSERT-NAME
    CALL "QUEUE-IS-EMPTY" USING DS-QUEUE WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

ASSERT-QUEUE-EMPTY.
    MOVE 1 TO WS-ASSERT-EXPECTED
    MOVE "queue removal should finish empty" TO WS-ASSERT-NAME
    CALL "QUEUE-IS-EMPTY" USING DS-QUEUE WS-BOOLEAN-ACTUAL
    MOVE WS-BOOLEAN-ACTUAL TO WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL
    MOVE 0 TO WS-ASSERT-EXPECTED
    MOVE "queue removal should finish with size 0" TO WS-ASSERT-NAME
    CALL "QUEUE-SIZE" USING DS-QUEUE WS-ASSERT-ACTUAL
    PERFORM ASSERT-EQUAL.

ASSERT-NULL.
    IF WS-NODE-NEXT = NULL
        MOVE 1 TO WS-ASSERT-ACTUAL
    ELSE
        MOVE 0 TO WS-ASSERT-ACTUAL
    END-IF
    PERFORM ASSERT-EQUAL.

ASSERT-EQUAL.
    ADD 1 TO WS-ASSERT-TOTAL
    IF WS-ASSERT-ACTUAL = WS-ASSERT-EXPECTED
        ADD 1 TO WS-ASSERT-PASSED
        DISPLAY "  [OK] " WS-ASSERT-NAME
    ELSE
        ADD 1 TO WS-ASSERT-FAILED
        DISPLAY "  [FAIL] " WS-ASSERT-NAME
        DISPLAY "         Expected: " WS-ASSERT-EXPECTED
        DISPLAY "           Actual: " WS-ASSERT-ACTUAL
    END-IF.

ASSERT-REPORT.
    DISPLAY " "
    DISPLAY "SUMMARY:"
    DISPLAY "  Total:    " WS-ASSERT-TOTAL
    DISPLAY "  Passed:   " WS-ASSERT-PASSED
    DISPLAY "  Failed:   " WS-ASSERT-FAILED
    DISPLAY " "
    DISPLAY "========================================="
    DISPLAY " GLOBAL RESULTS"
    DISPLAY "========================================="
    IF WS-ASSERT-FAILED > 0
        DISPLAY "  >>> SOME TESTS FAILED <<<"
        MOVE 1 TO RETURN-CODE
    ELSE
        DISPLAY "  >>> ALL TESTS PASSED <<<"
        MOVE 0 TO RETURN-CODE
    END-IF.

END PROGRAM RUN-TESTS.
