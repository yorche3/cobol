IDENTIFICATION DIVISION.
PROGRAM-ID. NAIVE-SORT-TESTS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ASSERT-TOTAL    PIC 9(03) VALUE 0.
01 WS-ASSERT-PASSED   PIC 9(03) VALUE 0.
01 WS-ASSERT-FAILED   PIC 9(03) VALUE 0.
01 WS-ASSERT-EXPECTED PIC S9(9).
01 WS-ASSERT-ACTUAL   PIC S9(9).
01 WS-ASSERT-NAME     PIC X(80).
01 WS-TEMP-NAME       PIC X(80).
01 WS-TEMP-LEN        PIC 9(02) VALUE 0.
01 WS-TEMP-POS        PIC 9(02) VALUE 1.
01 WS-TEMP-CHAR       PIC X(1).
01 WS-TEMP-BUFFER     PIC X(80).

*> Tabla de casos de prueba (7 casos por algoritmo)
01 WS-CASE-COUNT       PIC 9(02) VALUE 7.
01 WS-IDX              PIC 9(02).
01 WS-CASES.
   05 WS-CASE OCCURS 7 TIMES.
       10 CA-INPUT      PIC S9(9) OCCURS 6 TIMES.
       10 CA-OUTPUT     PIC S9(9) OCCURS 6 TIMES.
       10 CA-LENGTH     PIC 9(02).
       10 CA-NAME       PIC X(40).

*> Tabla para guardar el resultado del test
01 WS-RESULT-TABLE.
   05 WS-RESULT-ENTRY PIC S9(9) OCCURS 6 TIMES.

*> Variables auxiliares
01 WS-I                PIC 9(02).
01 WS-J                PIC 9(02).
01 WS-ALGO-NAME        PIC X(20).
01 WS-LENGTH           PIC 9(02).

PROCEDURE DIVISION.
MAIN.
    DISPLAY "========================================="
    DISPLAY " NAIVE SORT — Pruebas unitarias"
    DISPLAY "========================================="
    DISPLAY " "

    PERFORM INITIALIZE-CASES

    MOVE "selection_sort" TO WS-ALGO-NAME
    PERFORM TEST-SELECTION-SORT

    MOVE "bubble_sort" TO WS-ALGO-NAME
    PERFORM TEST-BUBBLE-SORT

    MOVE "insertion_sort" TO WS-ALGO-NAME
    PERFORM TEST-INSERTION-SORT

    DISPLAY " "
    DISPLAY "========================================="
    DISPLAY " GLOBAL RESULTS"
    DISPLAY "========================================="

    STOP RUN.

INITIALIZE-CASES.
    *> Caso 1: Array estándar desordenado
    MOVE 6 TO CA-LENGTH(1)
    MOVE 5 TO CA-INPUT(1,1)
    MOVE 2 TO CA-INPUT(1,2)
    MOVE 9 TO CA-INPUT(1,3)
    MOVE 1 TO CA-INPUT(1,4)
    MOVE 5 TO CA-INPUT(1,5)
    MOVE 6 TO CA-INPUT(1,6)
    MOVE 1 TO CA-OUTPUT(1,1)
    MOVE 2 TO CA-OUTPUT(1,2)
    MOVE 5 TO CA-OUTPUT(1,3)
    MOVE 5 TO CA-OUTPUT(1,4)
    MOVE 6 TO CA-OUTPUT(1,5)
    MOVE 9 TO CA-OUTPUT(1,6)
    MOVE "sort unsorted array" TO CA-NAME(1)

    *> Caso 2: Array ya ordenado
    MOVE 5 TO CA-LENGTH(2)
    MOVE 1 TO CA-INPUT(2,1)
    MOVE 2 TO CA-INPUT(2,2)
    MOVE 3 TO CA-INPUT(2,3)
    MOVE 4 TO CA-INPUT(2,4)
    MOVE 5 TO CA-INPUT(2,5)
    MOVE 0 TO CA-INPUT(2,6)
    MOVE 1 TO CA-OUTPUT(2,1)
    MOVE 2 TO CA-OUTPUT(2,2)
    MOVE 3 TO CA-OUTPUT(2,3)
    MOVE 4 TO CA-OUTPUT(2,4)
    MOVE 5 TO CA-OUTPUT(2,5)
    MOVE 0 TO CA-OUTPUT(2,6)
    MOVE "sort already sorted array" TO CA-NAME(2)

    *> Caso 3: Array en orden inverso
    MOVE 5 TO CA-LENGTH(3)
    MOVE 5 TO CA-INPUT(3,1)
    MOVE 4 TO CA-INPUT(3,2)
    MOVE 3 TO CA-INPUT(3,3)
    MOVE 2 TO CA-INPUT(3,4)
    MOVE 1 TO CA-INPUT(3,5)
    MOVE 0 TO CA-INPUT(3,6)
    MOVE 1 TO CA-OUTPUT(3,1)
    MOVE 2 TO CA-OUTPUT(3,2)
    MOVE 3 TO CA-OUTPUT(3,3)
    MOVE 4 TO CA-OUTPUT(3,4)
    MOVE 5 TO CA-OUTPUT(3,5)
    MOVE 0 TO CA-OUTPUT(3,6)
    MOVE "sort reverse order array" TO CA-NAME(3)

    *> Caso 4: Elementos idénticos
    MOVE 4 TO CA-LENGTH(4)
    MOVE 7 TO CA-INPUT(4,1)
    MOVE 7 TO CA-INPUT(4,2)
    MOVE 7 TO CA-INPUT(4,3)
    MOVE 7 TO CA-INPUT(4,4)
    MOVE 0 TO CA-INPUT(4,5)
    MOVE 0 TO CA-INPUT(4,6)
    MOVE 7 TO CA-OUTPUT(4,1)
    MOVE 7 TO CA-OUTPUT(4,2)
    MOVE 7 TO CA-OUTPUT(4,3)
    MOVE 7 TO CA-OUTPUT(4,4)
    MOVE 0 TO CA-OUTPUT(4,5)
    MOVE 0 TO CA-OUTPUT(4,6)
    MOVE "sort identical elements" TO CA-NAME(4)

    *> Caso 5: Con números negativos
    MOVE 5 TO CA-LENGTH(5)
    MOVE 3 TO CA-INPUT(5,1)
    MOVE -1 TO CA-INPUT(5,2)
    MOVE 4 TO CA-INPUT(5,3)
    MOVE -5 TO CA-INPUT(5,4)
    MOVE 0 TO CA-INPUT(5,5)
    MOVE 0 TO CA-INPUT(5,6)
    MOVE -5 TO CA-OUTPUT(5,1)
    MOVE -1 TO CA-OUTPUT(5,2)
    MOVE 0 TO CA-OUTPUT(5,3)
    MOVE 3 TO CA-OUTPUT(5,4)
    MOVE 4 TO CA-OUTPUT(5,5)
    MOVE 0 TO CA-OUTPUT(5,6)
    MOVE "sort with negative numbers" TO CA-NAME(5)

    *> Caso 6: Un solo elemento
    MOVE 1 TO CA-LENGTH(6)
    MOVE 42 TO CA-INPUT(6,1)
    MOVE 0 TO CA-INPUT(6,2)
    MOVE 0 TO CA-INPUT(6,3)
    MOVE 0 TO CA-INPUT(6,4)
    MOVE 0 TO CA-INPUT(6,5)
    MOVE 0 TO CA-INPUT(6,6)
    MOVE 42 TO CA-OUTPUT(6,1)
    MOVE 0 TO CA-OUTPUT(6,2)
    MOVE 0 TO CA-OUTPUT(6,3)
    MOVE 0 TO CA-OUTPUT(6,4)
    MOVE 0 TO CA-OUTPUT(6,5)
    MOVE 0 TO CA-OUTPUT(6,6)
    MOVE "sort single element" TO CA-NAME(6)

    *> Caso 7: Array vacío
    MOVE 0 TO CA-LENGTH(7)
    MOVE 0 TO CA-INPUT(7,1)
    MOVE 0 TO CA-INPUT(7,2)
    MOVE 0 TO CA-INPUT(7,3)
    MOVE 0 TO CA-INPUT(7,4)
    MOVE 0 TO CA-INPUT(7,5)
    MOVE 0 TO CA-INPUT(7,6)
    MOVE 0 TO CA-OUTPUT(7,1)
    MOVE 0 TO CA-OUTPUT(7,2)
    MOVE 0 TO CA-OUTPUT(7,3)
    MOVE 0 TO CA-OUTPUT(7,4)
    MOVE 0 TO CA-OUTPUT(7,5)
    MOVE 0 TO CA-OUTPUT(7,6)
    MOVE "sort empty array" TO CA-NAME(7).

TEST-SELECTION-SORT.
    DISPLAY "--- selection_sort tests ---"
    DISPLAY " "
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > WS-CASE-COUNT
        PERFORM RUN-SELECTION-SORT-CASE
    END-PERFORM
    PERFORM ASSERT-REPORT.

TEST-BUBBLE-SORT.
    DISPLAY "--- bubble_sort tests ---"
    DISPLAY " "
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > WS-CASE-COUNT
        PERFORM RUN-BUBBLE-SORT-CASE
    END-PERFORM
    PERFORM ASSERT-REPORT.

TEST-INSERTION-SORT.
    DISPLAY "--- insertion_sort tests ---"
    DISPLAY " "
    PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > WS-CASE-COUNT
        PERFORM RUN-INSERTION-SORT-CASE
    END-PERFORM
    PERFORM ASSERT-REPORT.

RUN-SELECTION-SORT-CASE.
    PERFORM COPY-INPUT-TO-RESULT
    MOVE CA-LENGTH(WS-IDX) TO WS-LENGTH
    CALL "SELECTION-SORT" USING WS-RESULT-TABLE WS-LENGTH
    PERFORM COMPARE-RESULT.

RUN-BUBBLE-SORT-CASE.
    PERFORM COPY-INPUT-TO-RESULT
    MOVE CA-LENGTH(WS-IDX) TO WS-LENGTH
    CALL "BUBBLE-SORT" USING WS-RESULT-TABLE WS-LENGTH
    PERFORM COMPARE-RESULT.

RUN-INSERTION-SORT-CASE.
    PERFORM COPY-INPUT-TO-RESULT
    MOVE CA-LENGTH(WS-IDX) TO WS-LENGTH
    CALL "INSERTION-SORT" USING WS-RESULT-TABLE WS-LENGTH
    PERFORM COMPARE-RESULT.

COPY-INPUT-TO-RESULT.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 6
        MOVE CA-INPUT(WS-IDX,WS-I) TO WS-RESULT-ENTRY(WS-I)
    END-PERFORM.

COMPARE-RESULT.
    DISPLAY " "
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LENGTH
        MOVE CA-OUTPUT(WS-IDX,WS-I) TO WS-ASSERT-EXPECTED
        MOVE WS-RESULT-ENTRY(WS-I) TO WS-ASSERT-ACTUAL
        PERFORM BUILD-TEST-NAME
        PERFORM ASSERT-EQUAL
    END-PERFORM.

BUILD-TEST-NAME.
    MOVE WS-ALGO-NAME TO WS-TEMP-NAME
    MOVE " - " TO WS-TEMP-NAME(LENGTH OF WS-ALGO-NAME + 1:4)
    MOVE CA-NAME(WS-IDX) TO WS-TEMP-NAME(LENGTH OF WS-ALGO-NAME + 5:40)
    MOVE WS-TEMP-NAME TO WS-ASSERT-NAME.

COPY ASSERTS.

END PROGRAM NAIVE-SORT-TESTS.
